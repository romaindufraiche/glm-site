# Configuration Apache pour l'hébergement mutualisé OVH.
# Déposée à la racine du site (www/) avec le contenu du dossier dist/.

AddDefaultCharset UTF-8
Options -Indexes
ErrorDocument 404 /404.html

# ---------- Une seule adresse : https://www.glmprime.com ----------
# HTTPS obligatoire, et la variante sans www renvoie vers www (l'adresse canonique déclarée dans les
# pages). Une adresse unique évite qu'un filtre de sécurité voie deux sites différents.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^glmprime\.com$ [NC]
  RewriteRule ^(.*)$ https://www.glmprime.com/$1 [R=301,L]
  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------- En-têtes de sécurité ----------
<IfModule mod_headers.c>
  # Politique de sécurité du contenu : tout est servi par le site lui-même
  # (polices, scripts, images, vidéos) ; aucun cadre ni contenu tiers.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # HTTPS imposé au navigateur pendant un an (le site n'est servi qu'en HTTPS).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Isole le site des autres onglets et interdit à d'autres sites d'embarquer ses fichiers.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # Ne pas annoncer la version de PHP de l'hébergement.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # ---------- Cache ----------
  # Fichiers générés par Astro : nom unique à chaque build, donc cache long.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages HTML, service worker de désinstallation et script PHP : toujours revalidés.
  <FilesMatch "\.(html|php)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---------- Fichiers sensibles ----------
<FilesMatch "^\.|\.(md|log|bak|dist|example)$">
  Require all denied
</FilesMatch>
