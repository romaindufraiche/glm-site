# Espace équipe : jamais indexé, jamais mis en cache.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store"
</IfModule>

# Transmet l'en-tête Authorization à PHP (accès par jeton à api.php sur l'hébergement mutualisé).
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
