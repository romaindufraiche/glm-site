---
import '../styles/global.css';
import type { ComponentProps } from 'astro/types';
import EnTete from '../components/EnTete.astro';
import Nav from '../sections/Nav.astro';
import Footer from '../sections/Footer.astro';

type Props = ComponentProps<typeof EnTete>;
---

<!doctype html>
<html lang="fr">
  <head>
    <EnTete {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <Nav />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
