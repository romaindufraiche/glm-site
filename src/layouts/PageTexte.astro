---
import BaseLayout from './BaseLayout.astro';
import Surtitre from '../components/Surtitre.astro';

/** Gabarit des pages de texte (mentions légales, confidentialité, pages utilitaires). */
interface Props {
  titre: string;
  surtitre: string;
  description: string;
  noindex?: boolean;
  miseAJour?: string;
}

const { titre, surtitre, description, noindex = false, miseAJour } = Astro.props;
---

<BaseLayout titre={titre} description={description} noindex={noindex}>
  <article class="page surface-ivoire">
    <div class="container page__inner">
      <header class="page__tete">
        <Surtitre>{surtitre}</Surtitre>
        <h1 class="page__titre">{titre}</h1>
        {miseAJour && <p class="page__maj">Dernière mise à jour : {miseAJour}</p>}
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--section-y);
    min-height: 60vh;
  }

  .page__inner {
    display: grid;
    gap: var(--space-7);
  }

  .page__tete {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: var(--border) solid var(--pierre);
  }

  .page__titre {
    font-size: var(--fs-h2);
  }

  .page__maj {
    font-size: var(--fs-petit);
    color: var(--texte-doux);
  }

  .prose {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-6);
    font-size: var(--fs-h3);
  }

  .prose :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    list-style: square;
  }

  .prose :global(dl) {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .prose :global(dt) {
    font-weight: var(--fw-semibold);
  }

  .prose :global(dd) {
    margin: 0 0 var(--space-2);
  }
</style>
