---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import CalibreRepere from './CalibreRepere.astro';
import { calibres, type Projet } from '../data/site';

interface Props {
  projet: Projet;
}

const { projet } = Astro.props;
const { accent } = calibres[projet.calibre];

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projets/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const image = projet.image ? images[`../assets/projets/${projet.image.fichier}`]?.default : undefined;
if (projet.image && !image) {
  throw new Error(`Image de projet introuvable dans src/assets/projets/ : ${projet.image.fichier}`);
}

// Les trois repères d’un projet, dans l’ordre de lecture : le problème, la réponse, le bénéfice.
const reperes = [
  { titre: 'Le besoin', texte: projet.besoin },
  { titre: 'Ce qu’il fait', texte: projet.capacite },
  { titre: 'Ce que ça change', texte: projet.gain },
];
---

<article class={`carte accent-${accent}`}>
  {image && projet.image && (
    <Image
      src={image}
      alt={projet.image.alt}
      widths={[480, 720, 1080]}
      sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 46vw, 640px"
      loading="lazy"
      class="carte__image"
    />
  )}
  <div class="carte__corps">
    <div class="carte__meta">
      <CalibreRepere calibre={projet.calibre} />
      {projet.exemple && <p class="carte__exemple">Exemple</p>}
    </div>
    <h3 class="carte__nom">{projet.nom}</h3>
    <p class="carte__client">{projet.client}</p>
    <dl class="carte__reperes">
      {reperes.map((repere) => (
        <div>
          <dt>{repere.titre}</dt>
          <dd>{repere.texte}</dd>
        </div>
      ))}
    </dl>
    {projet.lien && (
      <a class="carte__lien" href={projet.lien.url} target="_blank" rel="noopener noreferrer">
        {projet.lien.libelle}
        <span class="sr-only"> (nouvel onglet)</span>
        <span aria-hidden="true"> ↗</span>
      </a>
    )}
  </div>
</article>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: var(--border) solid var(--trait);
    border-top: var(--bar) solid var(--accent);
    background: var(--fond);
  }

  .accent-corail {
    --accent: var(--corail);
  }
  .accent-jade {
    --accent: var(--jade);
  }
  .accent-bleu {
    --accent: var(--bleu);
  }

  /* Capture d’écran en bandeau, dans ses proportions d’origine. */
  .carte :global(.carte__image) {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: var(--border) solid var(--trait);
  }

  .carte__corps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .carte__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .carte__exemple {
    padding: 0 var(--space-2);
    border: var(--border) solid var(--texte-doux);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--texte-doux);
  }

  .carte__nom {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .carte__client {
    font-size: var(--fs-petit);
    font-weight: var(--fw-medium);
    color: var(--texte-doux);
  }

  /* Trois repères courts, séparés par un filet : une lecture en liste, sans puces. */
  .carte__reperes {
    display: grid;
    margin: var(--space-2) 0 0;
  }

  .carte__reperes > div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--border) solid var(--trait);
  }

  .carte__reperes dt {
    font-size: var(--fs-surtitre);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-surtitre);
    text-transform: uppercase;
    color: var(--texte-doux);
  }

  .carte__reperes dd {
    margin: 0;
  }

  .carte__lien {
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: var(--fw-medium);
  }
</style>
