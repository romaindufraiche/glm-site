---
import CalibreRepere from './CalibreRepere.astro';
import { calibres, type Projet } from '../data/site';

interface Props {
  projet: Projet;
}

const { projet } = Astro.props;
const { accent } = calibres[projet.calibre];
---

<article class={`carte accent-${accent}`}>
  <div class="carte__meta">
    <CalibreRepere calibre={projet.calibre} />
    {projet.exemple && <p class="carte__exemple">Exemple</p>}
  </div>
  <h3 class="carte__nom">{projet.nom}</h3>
  <p class="carte__client">{projet.client}</p>
  <p class="carte__resultat">{projet.resultat}</p>
  {projet.lien && (
    <a class="carte__lien" href={projet.lien.url} target="_blank" rel="noopener noreferrer">
      {projet.lien.libelle}
      <span class="sr-only"> (nouvel onglet)</span>
      <span aria-hidden="true"> ↗</span>
    </a>
  )}
</article>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5) var(--space-5) var(--space-6);
    border: var(--border) solid var(--trait);
    border-top: var(--bar) solid var(--accent);
    background: var(--fond);
  }

  .accent-corail {
    --accent: var(--corail);
  }
  .accent-jade {
    --accent: var(--jade);
  }
  .accent-bleu {
    --accent: var(--bleu);
  }

  /* Hauteur fixe sur deux lignes : les titres restent alignés quel que soit le nom du Calibre. */
  .carte__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    min-height: 2.6em;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .carte__exemple {
    padding: 0 var(--space-2);
    border: var(--border) solid var(--texte-doux);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--texte-doux);
  }

  .carte__nom {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .carte__client {
    font-size: var(--fs-petit);
    font-weight: var(--fw-medium);
    color: var(--texte-doux);
  }

  .carte__resultat {
    padding-top: var(--space-3);
    border-top: var(--border) solid var(--trait);
  }

  .carte__lien {
    margin-top: auto;
    padding-top: var(--space-3);
    font-weight: var(--fw-medium);
  }
</style>
