      <rect x="82" y="92" width="8" height="10" fill="#16181D" />
      <rect x="110" y="92" width="8" height="10" fill="#16181D" />
      <rect x="96" y="116" width="8" height="10" fill="#16181D" />
      <rect class="personnage__question" x="170" y="20" width="14" height="6" />
