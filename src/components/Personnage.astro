---
/**
 * Personnages de la série « T’as cru ? » (dessinés en aplats, bords droits, comme sur les carrousels).
 * Hugo, le curieux : haut jade, pose « intrigué ». Nora, l’experte : haut corail, pose « explique ».
 * Règle de la série : jamais un personnage sur un fond de la couleur de son haut.
 */
interface Props {
  nom: 'hugo' | 'nora';
  class?: string;
}

const { nom, class: className } = Astro.props;
---

<svg class:list={['personnage', className]} viewBox="0 0 200 320" aria-hidden="true" focusable="false">
  {nom === 'hugo' ? (
    <g>
      <rect x="72" y="250" width="22" height="58" fill="#0B1533" />
      <rect x="106" y="250" width="22" height="58" fill="#0B1533" />
