---
import Filet from './Filet.astro';

/** Surtitre : filet tricolore + IBM Plex Sans SemiBold en capitales espacées (charte p. 23). */
interface Props {
  as?: 'p' | 'span';
  class?: string;
}

const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['surtitre', className]}>
  <Filet />
  <span>
    <slot />
  </span>
</Tag>

<style>
  .surtitre {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-surtitre);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-surtitre);
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--texte);
  }
</style>
