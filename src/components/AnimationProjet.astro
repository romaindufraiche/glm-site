---
/**
 * Animation d’une carte projet, calée sur la capture recadrée en 16:10 (1440 × 900).
 * Les positions sont en pourcentage de ce cadre : x % = px / 14,4 ; y % = px / 9.
 * Au repos, la capture s’affiche seule ; la classe « est-active » posée sur la carte
 * (survol, focus, ou carte de face sur écran tactile) lance l’animation.
 */
import type { AnimationProjet } from '../data/site';

interface Props {
  type: AnimationProjet;
}

const { type } = Astro.props;

const six = [0, 1, 2, 3, 4, 5];
---

{type === 'adpvo' && (
  <div class="anim anim--adpvo" aria-hidden="true">
    <div class="adp-survol">
      <svg class="adp-curseur" viewBox="0 0 16 22">
        <path d="M1 1 L1 17 L5 13 L8 20 L11 19 L8 12 L14 12 Z" />
      </svg>
    </div>
  </div>
)}

{type === 'crocomix' && (
  <div class="anim anim--crocomix" aria-hidden="true">
    <div class="cro-piste">
      <span class="cro-tete" />
    </div>
    {six.map((i) => (
      <span class={`cro-vu cro-vu--${i}`}>
        <i />
      </span>
    ))}
    <span class="cro-vu cro-vu--master">
      <i />
    </span>
    <div class="cro-scope">
      <svg viewBox="0 0 400 20" preserveAspectRatio="none">
        <path d="M0 10 C 12.5 2, 37.5 2, 50 10 S 87.5 18, 100 10 S 137.5 2, 150 10 S 187.5 18, 200 10 S 237.5 2, 250 10 S 287.5 18, 300 10 S 337.5 2, 350 10 S 387.5 18, 400 10" />
      </svg>
    </div>
  </div>
)}

{type === 'infohub' && (
  <div class="anim anim--infohub" aria-hidden="true">
    <div class="inf-eq">
      {Array.from({ length: 20 }, (_, i) => (
        <i class={`inf-barre inf-barre--${i % 5}`} />
      ))}
    </div>
    {[0, 1, 2].map((i) => (
      <svg class={`inf-courbe inf-courbe--${i}`} viewBox="0 0 75 26" preserveAspectRatio="none">
        <polyline points="0,8 8,12 15,9 23,15 30,13 38,18 45,14 53,19 60,17 68,21 75,19" />
      </svg>
    ))}
    <div class="inf-orbite">
      <span class="inf-iss" />
    </div>
    {six.map((i) => (
      <span class={`inf-live inf-live--${i}`} />
    ))}
  </div>
)}

{type === 'synapse' && (
  <div class="anim anim--synapse" aria-hidden="true">
    <div class="syn-focus" />
  </div>
)}

{type === 'pepites' && (
  <div class="anim anim--pepites" aria-hidden="true">
    <div class="pep-cache" />
    <div class="pep-curseur" />
  </div>
)}

<style is:global>
  /* ---------------------------------------------------------------- */
  /* Commun                                                           */
  /* ---------------------------------------------------------------- */
  .anim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .projet.est-active .anim {
    opacity: 1;
  }

  /* ---------------------------------------------------------------- */
  /* ADPVO : un visiteur parcourt les catégories d’offres             */
  /* ---------------------------------------------------------------- */
  .adp-survol {
    position: absolute;
    left: 9.375%;
    top: 43.89%;
    width: 9.58%;
    height: 10.22%;
    border: 2px solid #c8102e;
    border-radius: 6px;
    box-shadow: 0 6px 18px rgb(0 35 149 / 35%);
  }
  .adp-curseur {
    position: absolute;
    left: 55%;
    top: 55%;
    width: 1.1rem;
    fill: #fff;
    stroke: #16181d;
    stroke-width: 1.2;
  }
  .projet.est-active .adp-survol {
    animation: adp-parcours 8s ease-in-out infinite;
  }
  .projet.est-active .adp-curseur {
    animation: adp-clic 2s ease-in-out infinite;
  }
  @keyframes adp-parcours {
    0%,
    12% {
      transform: translateX(107.3%);
    }
    22%,
    37% {
      transform: translateX(321.9%);
    }
    47%,
    62% {
      transform: translateX(536.5%);
    }
    72%,
    87% {
      transform: translateX(643.8%);
    }
    100% {
      transform: translateX(107.3%);
    }
  }
  @keyframes adp-clic {
    0%,
    60%,
    100% {
      transform: scale(1);
    }
    70% {
      transform: scale(0.85);
    }
  }

  /* ---------------------------------------------------------------- */
  /* CrocoMix : la lecture avance, les vumètres et l’oscilloscope vivent */
  /* ---------------------------------------------------------------- */
  .cro-piste {
    position: absolute;
    left: 2.9%;
    right: 1%;
    top: 7.4%;
    height: 8.9%;
  }
  .cro-tete {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: #fff;
    box-shadow: 0 0 6px #fff;
  }
  .projet.est-active .cro-tete {
    animation: cro-lecture 12s linear infinite;
  }
  @keyframes cro-lecture {
    from {
      left: 0%;
    }
    to {
      left: 100%;
    }
  }
  .cro-vu {
    position: absolute;
    top: 31.67%;
    width: 0.55%;
    height: 11.1%;
    background: #070a12;
    display: flex;
    align-items: flex-end;
  }
  .cro-vu i {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, #2fbf55 0%, #3ecf5a 60%, #e8c43a 85%, #e9674f 100%);
    transform-origin: bottom;
    transform: scaleY(0.3);
  }
  .cro-vu--0 {
    left: 4.3%;
  }
  .cro-vu--1 {
    left: 10.7%;
  }
  .cro-vu--2 {
    left: 17.15%;
  }
  .cro-vu--3 {
    left: 23.55%;
  }
  .cro-vu--4 {
    left: 29.95%;
  }
  .cro-vu--5 {
    left: 36.3%;
  }
  .cro-vu--master {
    left: 43.95%;
    top: 33.33%;
    width: 0.7%;
    height: 10.9%;
  }
  .projet.est-active .cro-vu i {
    animation: cro-niveau 0.9s ease-in-out infinite alternate;
  }
  .projet.est-active .cro-vu--1 i {
    animation-duration: 0.55s;
    animation-delay: -0.2s;
  }
  .projet.est-active .cro-vu--2 i {
    animation-duration: 0.4s;
  }
  .projet.est-active .cro-vu--3 i {
    animation-duration: 0.75s;
    animation-delay: -0.4s;
  }
  .projet.est-active .cro-vu--4 i {
    animation-duration: 1.1s;
    animation-delay: -0.1s;
  }
  .projet.est-active .cro-vu--5 i {
    animation-duration: 0.65s;
    animation-delay: -0.3s;
  }
  .projet.est-active .cro-vu--master i {
    animation-duration: 0.5s;
  }
  @keyframes cro-niveau {
    0% {
      transform: scaleY(0.25);
    }
    35% {
      transform: scaleY(0.8);
    }
    60% {
      transform: scaleY(0.45);
    }
    100% {
      transform: scaleY(0.95);
    }
  }
  .cro-scope {
    position: absolute;
    left: 48.8%;
    right: 0;
    top: 42%;
    height: 4.9%;
    overflow: hidden;
    background: #0f1420;
  }
  .cro-scope svg {
    width: 200%;
    height: 100%;
    fill: none;
    stroke: #3fd6e8;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 2px #3fd6e8);
  }
  .projet.est-active .cro-scope svg {
    animation: cro-onde 1.6s linear infinite;
  }
  @keyframes cro-onde {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------------------------------------------------------------- */
  /* InfoHub : musique, cours, orbite de l’ISS et flux en direct      */
  /* ---------------------------------------------------------------- */
  .inf-eq {
    position: absolute;
    left: 81%;
    width: 14.1%;
    top: 26.6%;
    height: 2.8%;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    background: #050b14;
  }
  .inf-barre {
    flex: 1;
    height: 100%;
    background: #19c3e6;
    transform-origin: bottom;
    transform: scaleY(0.4);
  }
  .inf-barre:nth-child(odd) {
    background: #d63ad9;
  }
  .projet.est-active .inf-barre {
    animation: inf-eq 0.7s ease-in-out infinite alternate;
  }
  .projet.est-active .inf-barre--1 {
    animation-duration: 0.45s;
  }
  .projet.est-active .inf-barre--2 {
    animation-duration: 0.9s;
    animation-delay: -0.3s;
  }
  .projet.est-active .inf-barre--3 {
    animation-duration: 0.6s;
    animation-delay: -0.5s;
  }
  .projet.est-active .inf-barre--4 {
    animation-duration: 0.8s;
    animation-delay: -0.2s;
  }
  @keyframes inf-eq {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }
  .inf-courbe {
    position: absolute;
    left: 68.75%;
    width: 5.2%;
    height: 3%;
    fill: none;
    stroke: #ff3d6e;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    background: #0a0b16;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .inf-courbe--0 {
    top: 11%;
  }
  .inf-courbe--1 {
    top: 14%;
  }
  .inf-courbe--2 {
    top: 17%;
  }
  .projet.est-active .inf-courbe polyline {
    stroke-dasharray: 120;
    animation: inf-trace 2.4s ease-out infinite;
  }
  .projet.est-active .inf-courbe--1 polyline {
    animation-delay: -0.8s;
  }
  .projet.est-active .inf-courbe--2 polyline {
    animation-delay: -1.6s;
  }
  @keyframes inf-trace {
    from {
      stroke-dashoffset: 120;
    }
    70%,
    to {
      stroke-dashoffset: 0;
    }
  }
  .inf-orbite {
    position: absolute;
    left: 1.5%;
    width: 34.5%;
    top: 80.6%;
    height: 5.6%;
    background: linear-gradient(#0c0c1c, #0b0b1b);
  }
  .inf-iss {
    position: absolute;
    left: 0;
    top: 40%;
    width: 1.6%;
    aspect-ratio: 2;
    border-radius: 50%;
    background: #6fe3ff;
    box-shadow: 0 0 8px #6fe3ff;
  }
  .projet.est-active .inf-iss {
    animation:
      inf-iss-x 6s linear infinite,
      inf-iss-y 3s ease-in-out infinite alternate;
  }
  @keyframes inf-iss-x {
    from {
      left: 0%;
    }
    to {
      left: 98%;
    }
  }
  @keyframes inf-iss-y {
    from {
      top: 10%;
    }
    to {
      top: 70%;
    }
  }
  .inf-live {
    position: absolute;
    width: 1.9%;
    height: 1.3%;
    border-radius: 2px;
    box-shadow: 0 0 6px 1px #3cff7a;
    opacity: 0;
  }
  .inf-live--0 {
    left: 34.7%;
    top: 7%;
  }
  .inf-live--1 {
    left: 72%;
    top: 7%;
  }
  .inf-live--2 {
    left: 72%;
    top: 32.9%;
  }
  .inf-live--3 {
    left: 25.35%;
    top: 58.8%;
  }
  .inf-live--4 {
    left: 72%;
    top: 58.8%;
  }
  .inf-live--5 {
    left: 34.6%;
    top: 78.1%;
  }
  .projet.est-active .inf-live {
    animation: inf-live 1.4s ease-in-out infinite;
  }
  .projet.est-active .inf-live:nth-of-type(even) {
    animation-delay: -0.7s;
  }
  @keyframes inf-live {
    50% {
      opacity: 1;
    }
  }

  /* ---------------------------------------------------------------- */
  /* Synapse : la sélection passe d’une affiche à l’autre             */
  /* ---------------------------------------------------------------- */
  .syn-focus {
    position: absolute;
    left: 1.81%;
    top: 66.78%;
    width: 10%;
    height: 23.78%;
    border: 2px solid #ff2e88;
    box-shadow:
      0 0 14px #ff2e88,
      inset 0 0 10px rgb(255 46 136 / 40%);
  }
  .projet.est-active .syn-focus {
    animation: syn-parcours 9s ease-in-out infinite;
  }
  @keyframes syn-parcours {
    0%,
    10% {
      transform: translateX(108.7%) scale(1.04);
    }
    20%,
    30% {
      transform: translateX(326.1%) scale(1.04);
    }
    40%,
    50% {
      transform: translateX(543.5%) scale(1.04);
    }
    60%,
    70% {
      transform: translateX(760.9%) scale(1.04);
    }
    80%,
    90% {
      transform: translateX(434.8%) scale(1.04);
    }
    100% {
      transform: translateX(108.7%) scale(1.04);
    }
  }

  /* ---------------------------------------------------------------- */
  /* Pépites : le graphique se trace, le curseur suit le cours        */
  /* ---------------------------------------------------------------- */
  .pep-cache {
    position: absolute;
    left: 4.2%;
    right: 0;
    top: 38.5%;
    bottom: 1.5%;
    background: #fff;
    clip-path: inset(0 0 0 100%);
  }
  .pep-curseur {
    position: absolute;
    top: 38.5%;
    bottom: 1.5%;
    left: 4.2%;
    width: 0;
    border-left: 1px dashed #5b5e66;
    opacity: 0;
  }
  .projet.est-active .pep-cache {
    animation: pep-cache 7s ease-in-out infinite;
  }
  .projet.est-active .pep-curseur {
    animation: pep-curseur 7s ease-in-out infinite;
  }
  @keyframes pep-cache {
    0% {
      clip-path: inset(0 0 0 0);
    }
    75%,
    96% {
      clip-path: inset(0 0 0 100%);
    }
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes pep-curseur {
    0% {
      left: 4.2%;
      opacity: 1;
    }
    75% {
      left: 100%;
      opacity: 1;
    }
    76%,
    100% {
      left: 100%;
      opacity: 0;
    }
  }
</style>
