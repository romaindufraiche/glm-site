---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Surtitre from '../components/Surtitre.astro';
import BoutonReseau from '../components/BoutonReseau.astro';
import { media } from '../data/site';

const miniatures = import.meta.glob<{ default: ImageMetadata }>('../assets/tascru/*.{png,jpg,jpeg,webp}', {
  eager: true,
});

function miniatureDe(fichier: string): ImageMetadata {
  const image = miniatures[`../assets/tascru/${fichier}`]?.default;
  if (!image) throw new Error(`Miniature introuvable dans src/assets/tascru/ : ${fichier}`);
  return image;
}
---

<section class="tascru surface-ivoire" id="tas-cru" aria-labelledby="tascru-titre">
  <div class="container">
    <div class="tascru__carte surface-nuit">
      <div class="tascru__texte">
        <Surtitre>{media.surtitre}</Surtitre>
        <h2 id="tascru-titre" class="tascru__titre">
          <span class="tascru__tampon">{media.nom}</span>
          <span class="tascru__accroche">{media.accroche}</span>
        </h2>
        <div class="tascru__description">
          <p>{media.texte}</p>
          <p class="tascru__rythme">{media.rythme}</p>
        </div>
        <div class="tascru__actions">
          <BoutonReseau reseau="linkedin" href={media.lien}>
            Voir les vidéos sur LinkedIn
          </BoutonReseau>
          <span class="tascru__hashtag">{media.hashtag}</span>
        </div>
      </div>

      <ul class="tascru__episodes" aria-label="Quelques épisodes">
        {media.episodes.map((episode) => (
          <li>
            <Image
              src={miniatureDe(episode.miniature)}
              alt={`Miniature T’as cru ? : ${episode.question}`}
              widths={[240, 360, 540]}
              sizes="(max-width: 52rem) 45vw, 260px"
              loading="lazy"
              class="tascru__miniature"
            />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .tascru {
    padding-block: 0 var(--section-y);
  }

  .tascru__carte {
    display: grid;
    gap: var(--space-7);
    padding: var(--space-8);
    border-top: var(--bar) solid var(--corail);
  }

  .tascru__texte {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-5) var(--space-7);
    align-items: end;
  }

  .tascru__texte > :global(.surtitre),
  .tascru__titre {
    grid-column: 1 / -1;
  }

  .tascru__titre {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    font-size: var(--fs-h2);
    line-height: 1.1;
  }

  .tascru__tampon {
    padding: 0.1em 0.35em 0.18em;
    background: var(--corail);
    color: var(--nuit);
  }

  .tascru__accroche {
    max-width: 22ch;
  }

  .tascru__description {
    display: grid;
    gap: var(--space-3);
    max-width: 56ch;
    color: var(--texte-doux);
  }

  .tascru__rythme {
    font-weight: var(--fw-semibold);
    color: var(--texte);
  }

  .tascru__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }

  .tascru__hashtag {
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-surtitre);
    color: var(--texte-doux);
  }

  .tascru__episodes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tascru__miniature {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (max-width: 52rem) {
    .tascru__carte {
      padding: var(--space-6) var(--space-5);
      gap: var(--space-6);
    }

    .tascru__texte {
      grid-template-columns: 1fr;
    }

    .tascru__episodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
