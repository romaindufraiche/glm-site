---
import Surtitre from '../components/Surtitre.astro';
import Filet from '../components/Filet.astro';
---

<section class="vision surface-nuit" aria-labelledby="vision-titre">
  <div class="container vision__inner">
    <Surtitre>Vision</Surtitre>
    <h2 id="vision-titre" class="vision__texte">
      Notre cap&nbsp;: rendre l’IA et la robotique autonomes concrètes pour les entreprises en France et en
      Europe.
    </h2>
    <Filet taille="lg" />
  </div>
</section>

<style>
  .vision {
    padding-block: var(--section-y);
  }

  .vision__inner {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .vision__texte {
    max-width: 22ch;
    font-size: var(--fs-h2);
    line-height: 1.15;
  }
</style>
